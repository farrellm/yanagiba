root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab
indent_size = 4

[{*.yml,*.yaml,*.json}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

# Fixtures are byte-exact reproductions of fish's output; reformatting them
# would invalidate the round-trip tests.
[internal/fishhist/testdata/**]
trim_trailing_whitespace = false
insert_final_newline = false
